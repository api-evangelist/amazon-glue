            "body": {
              "mode": "raw",
              "raw": "{\n  \"SchemaId\": {\n    \"SchemaArn\": \"arn:aws-us-gov:glue:\",\n    \"SchemaName\": \"2k\",\n    \"RegistryName\": \"Vr#GkiTR\"\n  },\n  \"SchemaDefinition\": \"oFLpfotj\"\n}",
