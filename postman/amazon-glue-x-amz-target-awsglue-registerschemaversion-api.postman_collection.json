              "raw": "{\n  \"SchemaId\": {\n    \"SchemaArn\": \"arn:aws-us-gov:glue:[`\",\n    \"SchemaName\": \"RVAIHa_V\",\n    \"RegistryName\": \"Z\"\n  },\n  \"SchemaDefinition\": \"l}+;2>$Z]|je\"\n}",
